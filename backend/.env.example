# --- Security ---
ADMIN_TOKEN=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173,https://akashbhalshankar.com

# --- Google Drive (service account with Viewer access to the resume file) ---
DRIVE_FILE_ID=your-drive-file-id
# Either a path to the key file...
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# ...or the JSON itself (handy on Render / Railway):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- Sync behaviour ---
SYNC_INTERVAL_HOURS=6
# false = every sync creates a draft you approve. true = publish automatically.
AUTO_APPROVE=false
# true = keep hand-written content (Chikki challenges, hero lines, links, flagship flags) when the resume is re-parsed
PRESERVE_CURATED=true
DATA_DIR=./data

# --- LLM providers (tried in this order, first success wins). Leave a key empty to skip a provider. ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Contact form ---
# Where messages go. With SMTP unset, messages are saved to data/messages.jsonl instead.
CONTACT_TO=akashbhalshankar07@gmail.com
CONTACT_PER_HOUR=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail: create an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_PASS=
